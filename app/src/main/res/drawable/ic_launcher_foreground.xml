<?xml version="1.0" encoding="utf-8"?>
<!-- Dua mata rantai saling mengait, sama dengan berkas di folder logo/.
     Tiap mata digambar sebagai kapsul bergaris: satu goresan hitam tebal lalu
     satu goresan berwarna yang lebih tipis di atasnya, sehingga lubang di
     tengahnya tetap tembus tanpa perlu jalur terpisah.

     Seluruhnya duduk di dalam lingkaran aman 66dp dari kanvas ikon adaptif
     108dp, jadi tidak terpotong oleh topeng bulat maupun kotak. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Mata rantai kuning di bawah, digambar lebih dulu. -->
    <group
        android:rotation="-45"
        android:pivotX="47.3"
        android:pivotY="60.7">
        <path
            android:fillColor="#00000000"
            android:strokeColor="#000000"
            android:strokeWidth="10.2"
            android:pathData="M39.8,51.2 L54.8,51.2 A9.5,9.5 0 0 1 54.8,70.2 L39.8,70.2 A9.5,9.5 0 0 1 39.8,51.2 Z" />
        <path
            android:fillColor="#00000000"
            android:strokeColor="#FFD93D"
            android:strokeWidth="5.8"
            android:pathData="M39.8,51.2 L54.8,51.2 A9.5,9.5 0 0 1 54.8,70.2 L39.8,70.2 A9.5,9.5 0 0 1 39.8,51.2 Z" />
    </group>

    <!-- Mata rantai biru di atas, menimpa titik silangnya. -->
    <group
        android:rotation="-45"
        android:pivotX="60.7"
        android:pivotY="47.3">
        <path
            android:fillColor="#00000000"
            android:strokeColor="#000000"
            android:strokeWidth="10.2"
            android:pathData="M53.2,37.8 L68.2,37.8 A9.5,9.5 0 0 1 68.2,56.8 L53.2,56.8 A9.5,9.5 0 0 1 53.2,37.8 Z" />
        <path
            android:fillColor="#00000000"
            android:strokeColor="#7FD4FF"
            android:strokeWidth="5.8"
            android:pathData="M53.2,37.8 L68.2,37.8 A9.5,9.5 0 0 1 68.2,56.8 L53.2,56.8 A9.5,9.5 0 0 1 53.2,37.8 Z" />
    </group>
</vector>
